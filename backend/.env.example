# Copy to backend/.env for local development. Replace every REPLACE_* value.
APP_ENV=development
CORS_ALLOWED_ORIGINS=
AUTO_CREATE_TABLES=false

# Configure either DATABASE_URL or all DB_* variables below.
# DATABASE_URL=REPLACE_WITH_RAILWAY_MYSQL_URL
DB_HOST=REPLACE_WITH_MYSQL_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_MYSQL_DATABASE
DB_USER=REPLACE_WITH_MYSQL_USER
DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD

GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_GOOGLE_MAPS_KEY
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama is optional and disabled unless explicitly enabled.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=5

# Optional provider-offer timeout; defaults to five minutes.
PROVIDER_TIMEOUT_SECONDS=300